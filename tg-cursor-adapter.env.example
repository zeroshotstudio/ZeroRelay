# Telegram → Cursor webhook adapter
# Copy to /opt/zerorelay/tg-cursor-adapter.env and chmod 600.
# Never commit real values. The live env file is preserved across deploys.

CURSOR_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<uuid>
CURSOR_WEBHOOK_BEARER=crsr_<panel-sender-key>
TELEGRAM_SECRET_TOKEN=<random-secret>

# Public TLS terminates at Funnel/nginx. Bind localhost only.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787

# Optional: comma-separated Telegram chat IDs. Empty = any chat (secret still required).
# ALLOWED_CHAT_IDS=<chat-id>

# Optional: Cursor POST timeout in seconds (default 10).
# UPSTREAM_TIMEOUT_SEC=10
