[Unit]
Description=ZeroRelay Claude Code bridge (claude_ai)
After=network-online.target zerorelay.service
Wants=network-online.target

[Service]
Environment=HOME=/home/claude
Type=simple
User=claude
Group=claude
WorkingDirectory=/home/claude/ZeroVPS
ExecStart=/opt/zerorelay/venv/bin/python /opt/zerorelay/claude-bridge.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/opt/zerorelay/relay.env
ReadWritePaths=/opt/zerorelay

[Install]
WantedBy=multi-user.target
